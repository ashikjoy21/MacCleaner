# Release settings, read by scripts/release.sh and baked into install.sh and the app's update check.
APP_NAME="MacCleaner"
BUNDLE_ID="in.co.lno.MacCleaner"
# Public GitHub repo whose Releases host MacCleaner.zip, install.sh and latest.json.
GITHUB_REPO="ashikjoy21/MacCleaner"
# Name of the self-signed code-signing certificate (created by scripts/setup-signing.sh).
SIGNING_IDENTITY="MacCleaner Self-Signed"
